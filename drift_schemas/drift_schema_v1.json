  "fixed_sql": [
    {
      "name": "programs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"programs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL UNIQUE, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"program_id\" INTEGER NOT NULL REFERENCES programs (id), \"name\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL, \"type\" INTEGER NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"tracks_distance\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tracks_distance\" IN (0, 1)), UNIQUE (\"program_id\", \"name_key\"));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"day\" INTEGER NOT NULL, \"program_id\" INTEGER NOT NULL REFERENCES programs (id), \"time_in\" INTEGER NULL, \"time_out\" INTEGER NULL, \"volume\" INTEGER NOT NULL DEFAULT 0, \"set_count\" INTEGER NOT NULL DEFAULT 0, \"summary_pct\" INTEGER NULL, \"prev_session_id\" INTEGER NULL REFERENCES sessions (id) ON DELETE SET NULL, UNIQUE (\"day\"));"
        }
      ]
    },
    {
      "name": "exercise_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"exercise_id\" INTEGER NOT NULL REFERENCES exercises (id), \"day\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"volume\" INTEGER NOT NULL DEFAULT 0, \"set_count\" INTEGER NOT NULL DEFAULT 0, \"best_weight\" INTEGER NULL, \"reps_at_top\" INTEGER NOT NULL DEFAULT 0, \"pct\" INTEGER NULL, \"prev_log_id\" INTEGER NULL REFERENCES exercise_logs (id) ON DELETE SET NULL, UNIQUE (\"session_id\", \"exercise_id\"));"
        }
      ]
    },
    {
      "name": "set_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"set_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"exercise_log_id\" INTEGER NOT NULL REFERENCES exercise_logs (id) ON DELETE CASCADE, \"idx\" INTEGER NOT NULL, \"weight\" INTEGER NULL, \"reps\" INTEGER NOT NULL, \"distance\" INTEGER NULL, UNIQUE (\"exercise_log_id\", \"idx\"));"
        }
      ]
    },
    {
      "name": "day_summaries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"day_summaries\" (\"day\" INTEGER NOT NULL, \"session_id\" INTEGER NULL REFERENCES sessions (id) ON DELETE SET NULL, \"set_count\" INTEGER NOT NULL DEFAULT 0, \"is_rest\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_rest\" IN (0, 1)), PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "week_summaries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"week_summaries\" (\"week_start\" INTEGER NOT NULL, \"session_count\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"week_start\"));"
        }
      ]
    },
    {
      "name": "exercise_stats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_stats\" (\"exercise_id\" INTEGER NOT NULL REFERENCES exercises (id) ON DELETE CASCADE, \"best_weight\" INTEGER NULL, \"best_reps_at_weight\" INTEGER NULL, \"best_volume\" INTEGER NOT NULL DEFAULT 0, \"last_log_id\" INTEGER NULL REFERENCES exercise_logs (id) ON DELETE SET NULL, PRIMARY KEY (\"exercise_id\"));"
        }
      ]
    },
    {
      "name": "suggestions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"suggestions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"exercise_log_id\" INTEGER NULL REFERENCES exercise_logs (id) ON DELETE CASCADE, \"rule_id\" TEXT NOT NULL, \"priority\" INTEGER NOT NULL, \"params\" TEXT NOT NULL DEFAULT '{}');"
